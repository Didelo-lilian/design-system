{
  "name": "design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design system on MUI, React and Storybook",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Didelo-lilian/design-system.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc",
    "lint": "biome check",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run tokens && npm run lint && npm run typecheck && npm test && npm run build-storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "style-dictionary": "5.7.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
