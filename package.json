{
  "name": "@didelo/design-system",
  "version": "1.0.1",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "description": "Design system on MUI and React: tokens, theme and accessible components",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Didelo-lilian/design-system.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc",
    "lint": "biome check",
    "test": "node --test \"src/**/*.test.ts\" && vitest run",
    "check": "npm run tokens && npm run lint && npm run typecheck && npm test && npm run build-storybook && npm run build && npm run check:package",
    "build": "npm run tokens && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/addon-vitest": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.4",
    "style-dictionary": "5.7.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
